#!/usr/bin/env bash
#
# gamescope-launch — launch a game through Gamescope using the settings written
# by COSMIC Settings → Display → Gaming (~/.config/cosmic-gamescope.conf).
#
# Usage (Steam launch options):   gamescope-launch %command%
# Usage (CLI):                    gamescope-launch -- vkcube
#
set -euo pipefail

CONF="${COSMIC_GAMESCOPE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/cosmic-gamescope.conf}"

# defaults (mirror GamingConf::default in cosmic-settings)
OUT_WIDTH=3840 OUT_HEIGHT=2160 RENDER_SCALE=100 UPSCALER=auto SHARPNESS=2
FPS_LIMIT=0 HDR=0 ADAPTIVE_SYNC=1 MANGOAPP=0 FORCE_GRAB_CURSOR=0 STEAM=0 PREFER_DISCRETE=1

if [ -r "$CONF" ]; then
    while IFS='=' read -r key val; do
        key="${key// /}"; val="${val// /}"
        [ -z "$key" ] && continue
        case "$key" in
            OUT_WIDTH|OUT_HEIGHT|RENDER_SCALE|UPSCALER|SHARPNESS|FPS_LIMIT|HDR|\
            ADAPTIVE_SYNC|MANGOAPP|FORCE_GRAB_CURSOR|STEAM|PREFER_DISCRETE)
                printf -v "$key" '%s' "$val" ;;
        esac
    done < "$CONF"
fi

args=( -W "$OUT_WIDTH" -H "$OUT_HEIGHT" )

if [ "$RENDER_SCALE" -lt 100 ] 2>/dev/null; then
    args+=( -w "$(( OUT_WIDTH * RENDER_SCALE / 100 ))" -h "$(( OUT_HEIGHT * RENDER_SCALE / 100 ))" )
fi

if [ "$UPSCALER" != "auto" ]; then
    args+=( -F "$UPSCALER" )
    case "$UPSCALER" in fsr|nis) args+=( --sharpness "$SHARPNESS" ) ;; esac
fi

[ "$FPS_LIMIT" -gt 0 ] 2>/dev/null && args+=( -r "$FPS_LIMIT" )
[ "$HDR" = "1" ]               && args+=( --hdr-enabled )
[ "$ADAPTIVE_SYNC" = "1" ]     && args+=( --adaptive-sync )
[ "$MANGOAPP" = "1" ]          && args+=( --mangoapp )
[ "$FORCE_GRAB_CURSOR" = "1" ] && args+=( --force-grab-cursor )
[ "$STEAM" = "1" ]             && args+=( -e )

# On hybrid systems, pin the discrete GPU's Vulkan device (vendor:device).
if [ "$PREFER_DISCRETE" = "1" ]; then
    for d in /sys/class/drm/card*/device; do
        [ -r "$d/vendor" ] || continue
        vendor=$(<"$d/vendor"); class=$(<"$d/class" 2>/dev/null || echo "")
        # 0x10de = NVIDIA, 0x1002 = AMD; skip integrated by checking boot_vga=0 when present
        if [ "$vendor" = "0x10de" ] || { [ "$vendor" = "0x1002" ] && [ "$(cat "$d/boot_vga" 2>/dev/null || echo 0)" = "0" ]; }; then
            dev=$(<"$d/device")
            args+=( --prefer-vk-device "${vendor#0x}:${dev#0x}" )
            break
        fi
    done
fi

# strip a leading "--" so both `gamescope-launch -- cmd` and `gamescope-launch cmd` work
[ "${1:-}" = "--" ] && shift

exec gamescope "${args[@]}" -- "$@"
